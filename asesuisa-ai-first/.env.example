# Copiar a .env (nunca versionar .env). Todo secreto se inyecta por entorno.
DATABASE_URL=sqlite:///./data/dev.db
JWT_SECRET=change-me-with-a-long-random-value-at-least-32-chars
DEMO_PASSWORD=change-me-demo-password
AI_PROVIDER=mock
# Puerto del servidor local (python -m app) y, con docker compose, del host
APP_PORT=8765
# Solo para docker compose:
POSTGRES_PASSWORD=change-me-postgres-password
# true: pip-audit contra la red; false: queda "no verificado" (nunca "pasó")
PIPELINE_DEPENDENCY_AUDIT=true
